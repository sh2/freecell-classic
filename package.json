{
  "name": "freecell-classic",
  "version": "1.0.0",
  "private": true,
  "description": "Microsoft FreeCell 互換のフリーセル (クラシックルール)",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "benchmark": "node scripts/benchmark/run.js",
    "benchmark:all": "node scripts/benchmark/run.js --all",
    "benchmark:report": "node scripts/benchmark/report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vitest": "^4.1.10"
  }
}
